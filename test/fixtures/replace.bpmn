<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://flowable.org/bpmn"
             id="Definitions_1">
  <signal id="Signal_1" name="alarm" />
  <process id="Process_1" isExecutable="true">
    <userTask id="UserTask_1" name="Review" flowable:assignee="${initiator}" flowable:formKey="review" flowable:async="true">
      <extensionElements>
        <flowable:taskListener event="create" class="org.example.CreateListener" />
        <flowable:formProperty id="approved" type="boolean" />
        <flowable:executionListener event="start" class="org.example.StartListener" />
      </extensionElements>
    </userTask>
    <serviceTask id="MailTask" name="Notify" flowable:type="mail">
      <extensionElements>
        <flowable:field name="to">
          <flowable:string>kermit@example.org</flowable:string>
        </flowable:field>
        <flowable:mapException errorCode="mailFailed">org.example.MailException</flowable:mapException>
        <flowable:executionListener event="end" class="org.example.EndListener" />
      </extensionElements>
    </serviceTask>
    <serviceTask id="HttpTask" name="Call" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod">
          <flowable:string>GET</flowable:string>
        </flowable:field>
        <flowable:httpRequestHandler class="org.example.RequestHandler" />
      </extensionElements>
    </serviceTask>
    <startEvent id="RegistryStart" name="Order received">
      <extensionElements>
        <flowable:eventType>orderReceived</flowable:eventType>
        <flowable:eventCorrelationParameter name="customerId" value="${customerId}" />
        <flowable:eventOutParameter source="orderId" target="orderId" />
        <flowable:executionListener event="start" class="org.example.StartListener" />
      </extensionElements>
    </startEvent>
    <callActivity id="CallActivity_1" name="Subprocess" calledElement="sub">
      <extensionElements>
        <flowable:in source="orderId" target="orderId" />
        <flowable:out source="result" target="result" />
      </extensionElements>
    </callActivity>
    <boundaryEvent id="VariableBoundary" attachedToRef="CallActivity_1" cancelActivity="false">
      <extensionElements>
        <flowable:variableListenerEventDefinition variableName="status" />
      </extensionElements>
    </boundaryEvent>
    <boundaryEvent id="ErrorBoundary" attachedToRef="CallActivity_1">
      <errorEventDefinition flowable:errorVariableName="error" flowable:errorVariableLocalScope="true" />
    </boundaryEvent>
    <intermediateThrowEvent id="SignalThrow" name="Raise alarm">
      <signalEventDefinition signalRef="Signal_1" flowable:async="true" flowable:signalExpression="${alarmName}" />
    </intermediateThrowEvent>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="UserTask_1_di" bpmnElement="UserTask_1">
        <dc:Bounds x="100" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MailTask_di" bpmnElement="MailTask">
        <dc:Bounds x="260" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HttpTask_di" bpmnElement="HttpTask">
        <dc:Bounds x="420" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RegistryStart_di" bpmnElement="RegistryStart">
        <dc:Bounds x="132" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CallActivity_1_di" bpmnElement="CallActivity_1">
        <dc:Bounds x="260" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="VariableBoundary_di" bpmnElement="VariableBoundary">
        <dc:Bounds x="272" y="292" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ErrorBoundary_di" bpmnElement="ErrorBoundary">
        <dc:Bounds x="322" y="292" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SignalThrow_di" bpmnElement="SignalThrow">
        <dc:Bounds x="452" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
